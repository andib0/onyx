{
  "name": "daily-tracker-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier src/ --check",
    "format:write": "prettier src/ --write",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "perf:seed": "node scripts/perf/seed_bench.mjs",
    "perf:bench": "node scripts/perf/bench.mjs",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "db:verify-deploy": "node scripts/verify-migrate-deploy.mjs",
    "db:deploy": "bash scripts/migrate-deploy.sh",
    "perf:today": "tsx scripts/perf/today.bench.ts",
    "check": "node ../scripts/check.mjs backend",
    "check:docs": "node ../scripts/check-agents-md.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.39.1",
    "fast-check": "^3.23.2",
    "globals": "^16.5.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
